direction: right

jetson: Jetson Orin NX {
  style.fill: "#f8f9fa"
  style.stroke: "#343a40"

  # ── Hardware / Host ────────────────────────────────────────────────────────
  cameras: "Câmeras ZED X One S\n(hardware / GMSL2 kernel driver)" {
    style.fill: "#e9ecef"
    style.stroke: "#868e96"
    cam0: cam0
    cam1: cam1
  }

  host_services: "Host" {
    style.fill: "#e9ecef"
    style.stroke: "#868e96"
    tailscale_d: "tailscaled\n(systemd)"
    argus: "Argus daemon\n(NVIDIA)"
  }

  storage: "Storage (host volumes)" {
    style.fill: "#e9ecef"
    style.stroke: "#868e96"
    nvme: "NVMe\nDVR segments" { shape: cylinder }
    events: "events\nclips pós-IA" { shape: cylinder }
    sqlite: "SQLite\nindex + events" { shape: cylinder }
    tmpfs: "tmpfs /dev/shm\nevent buffer" { shape: cylinder; style.fill: "#fff8e1" }
  }

  # ── Docker Compose ─────────────────────────────────────────────────────────
  compose: "Docker Compose  (3 containers)" {
    style.fill: "#e7f5ff"
    style.stroke: "#1971c2"

    recorder: "recorder\n(profile: jetson)\nNVIDIA runtime + privileged" {
      style.fill: "#dbe4ff"
      style.stroke: "#4263eb"

      pipeline: GStreamer Pipeline {
        style.fill: "#edf2ff"
        dvr: "Branch A — DVR\nnvv4l2h265enc"
        buf: "Branch C — Event Buffer\ntmpfs 60s circular"
        ai: "Branch B — AI\n⚠ disabled" {
          style.fill: "#fff0f0"
          style.stroke: "#e03131"
        }
      }

      worker: "UploadWorker  ⚠ disabled" {
        style.fill: "#fff0f0"
        style.stroke: "#e03131"
        style.stroke-dash: 5
      }
    }

    clipapi: "clip-api\n:8080" {
      style.fill: "#d3f9d8"
      style.stroke: "#2f9e44"
    }

    dashboard: "dashboard\n:3000" {
      style.fill: "#d3f9d8"
      style.stroke: "#2f9e44"
    }

    preview: "preview  (dev only)\nMediaMTX :8554 :8889" {
      style.fill: "#f0f0f0"
      style.stroke: "#868e96"
      style.stroke-dash: 5
    }
  }
}

conveyor: "Conveyor  ⚠ disabled" {
  style.fill: "#fff0f0"
  style.stroke: "#e03131"
  style.stroke-dash: 5
  vstp: "VSTP pdevsample\ngw: 000011113333"
  s3: "S3  4cbb47c1331a/..." { shape: cylinder }
}

infra: Infra {
  style.fill: "#f8f9fa"
  tailscale: "Tailscale\nomnitrac-4cbb47c1331a" {
    shape: oval
    style.fill: "#e7f5ff"
    style.stroke: "#1971c2"
  }
  registerapi: "omni-ops\nregister-api" {
    style.fill: "#ebfbee"
    style.stroke: "#2f9e44"
  }
}

operator: Operador { shape: person }

# ── câmeras → pipeline ────────────────────────────────────────────────────────
jetson.cameras -> jetson.compose.recorder.pipeline: NVMM via Argus

# ── pipeline → storage ────────────────────────────────────────────────────────
jetson.compose.recorder.pipeline.dvr -> jetson.storage.nvme
jetson.compose.recorder.pipeline.dvr -> jetson.storage.sqlite: index
jetson.compose.recorder.pipeline.buf -> jetson.storage.tmpfs

# ── AI → eventos (disabled) ──────────────────────────────────────────────────
jetson.compose.recorder.pipeline.ai -> jetson.storage.events: flush clip {
  style.stroke: "#e03131"
  style.stroke-dash: 5
}
jetson.compose.recorder.pipeline.ai -> jetson.storage.sqlite: add_event() {
  style.stroke: "#e03131"
  style.stroke-dash: 5
}

# ── worker → Conveyor (disabled) ─────────────────────────────────────────────
jetson.compose.recorder.worker -> conveyor.vstp: samples.v2.Package {
  style.stroke: "#e03131"
  style.stroke-dash: 5
}
conveyor.vstp -> conveyor.s3 {
  style.stroke: "#e03131"
  style.stroke-dash: 5
}

# ── clip-api + dashboard ──────────────────────────────────────────────────────
jetson.storage.nvme -> jetson.compose.clipapi: ffmpeg -c copy
jetson.storage.sqlite -> jetson.compose.clipapi: query
jetson.storage.events -> jetson.compose.clipapi
jetson.compose.dashboard -> jetson.compose.clipapi: REST

# ── acesso remoto ─────────────────────────────────────────────────────────────
operator -> infra.tailscale
infra.tailscale -> jetson.compose.clipapi: :8080
infra.tailscale -> jetson.compose.dashboard: :3000

# ── provisioning ──────────────────────────────────────────────────────────────
operator -> infra.registerapi: provision.sh
infra.registerapi -> infra.tailscale: auth_key
