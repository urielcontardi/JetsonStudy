direction: right

# ─────────────────────────────────────────────────────────────────────────────
# Coluna 1 — Entrada
# ─────────────────────────────────────────────────────────────────────────────
cameras: "📷 Câmeras\nZED X One S × 2\n\nGMSL2 (coaxial)\nDriver kernel no host" {
  style.fill: "#f1f3f5"
  style.stroke: "#868e96"
}

# ─────────────────────────────────────────────────────────────────────────────
# Coluna 2 — Processamento (Jetson)
# ─────────────────────────────────────────────────────────────────────────────
jetson: Jetson Orin NX {
  style.fill: "#f8f9fa"
  style.stroke: "#343a40"

  recorder: "🐳 recorder\n\nGrava câmeras em fMP4 no NVMe (DVR).\nMantém buffer circular no tmpfs.\nRoda IA quando habilitado." {
    style.fill: "#e7f5ff"
    style.stroke: "#1971c2"
  }

  ai_note: "🐳 recorder — Branch AI\n⚠ ai.enabled: false\n\nDetecta objetos via TensorRT.\nFlush do buffer → events/" {
    style.fill: "#fff5f5"
    style.stroke: "#e03131"
    style.stroke-dash: 5
  }

  preview: "🐳 preview\nDEV ONLY\n\nStream ao vivo via RTSP / WebRTC.\nPara monitorar câmeras durante dev.\nNão sobe em produção." {
    style.fill: "#f8f9fa"
    style.stroke: "#adb5bd"
    style.stroke-dash: 5
  }
}

# ─────────────────────────────────────────────────────────────────────────────
# Coluna 3 — Storage (host volumes)
# ─────────────────────────────────────────────────────────────────────────────
storage: "💾 Storage — volumes do host" {
  style.fill: "#f1f3f5"
  style.stroke: "#868e96"

  nvme: "NVMe\nDVR segments\nfMP4 · ~20 dias" { shape: cylinder; style.fill: "#ffffff" }
  tmpfs: "tmpfs\nbuf-0/1.m4s\nbuffer 60s" { shape: cylinder; style.fill: "#fff9db" }
  sqlite: "SQLite\nindex + events" { shape: cylinder; style.fill: "#ffffff" }
  events: "events/\nclips de IA" { shape: cylinder; style.fill: "#fff5f5"; style.stroke: "#e03131" }
}

# ─────────────────────────────────────────────────────────────────────────────
# Coluna 4 — APIs (Jetson Docker)
# ─────────────────────────────────────────────────────────────────────────────
apis: "APIs — Docker" {
  style.fill: "#ebfbee"
  style.stroke: "#2f9e44"

  clipapi: "🐳 clip-api :8080\n\nGET /clips\nGET /events\nGET /events/{id}/clip" {
    style.fill: "#d3f9d8"
    style.stroke: "#2f9e44"
  }

  dashboard: "🐳 dashboard :3000\n\nInterface web para\nvisualizar clips e eventos." {
    style.fill: "#d3f9d8"
    style.stroke: "#2f9e44"
  }

  worker: "UploadWorker\n⚠ disabled\n\nPoll events pendentes → empacota\nsamples.v2.Package → VSTP." {
    style.fill: "#fff5f5"
    style.stroke: "#e03131"
    style.stroke-dash: 5
  }
}

# ─────────────────────────────────────────────────────────────────────────────
# Coluna 5 — Acesso remoto / Cloud
# ─────────────────────────────────────────────────────────────────────────────
tailscale: "🔒 Tailscale\nomnitrac-4cbb47c1331a\n100.109.171.54\n\nTodo acesso remoto\npassa por aqui." {
  shape: oval
  style.fill: "#e7f5ff"
  style.stroke: "#1971c2"
}

conveyor: "☁ Conveyor\n⚠ disabled\n\nconveyor.tractian.com:8080\nRecebe VSTP → salva em S3:\n4cbb47c1331a/samples/..." {
  style.fill: "#fff5f5"
  style.stroke: "#e03131"
  style.stroke-dash: 5
}

operator: "👤 Operador\nTime Tractian" { shape: person }
registerapi: "omni-ops\nregister-api\n\nprovision.sh → gera\nauth_key Tailscale" {
  style.fill: "#f3f0ff"
  style.stroke: "#7048e8"
}

# ─────────────────────────────────────────────────────────────────────────────
# CONEXÕES
# ─────────────────────────────────────────────────────────────────────────────

# câmeras → recorder / preview
cameras -> jetson.recorder: GMSL2 via Argus
cameras -> jetson.preview: stream ao vivo { style.stroke-dash: 5; style.stroke: "#adb5bd" }

# recorder → storage (fluxo principal)
jetson.recorder -> storage.nvme: grava fMP4
jetson.recorder -> storage.tmpfs: buffer circular
jetson.recorder -> storage.sqlite: indexa

# AI → events (disabled)
jetson.ai_note -> storage.events: flush clip {
  style.stroke: "#e03131"
  style.stroke-dash: 5
}
jetson.ai_note -> storage.sqlite: add_event() {
  style.stroke: "#e03131"
  style.stroke-dash: 5
}

# storage → APIs
storage.nvme -> apis.clipapi: ffmpeg -c copy
storage.events -> apis.clipapi: serve clips
storage.sqlite -> apis.clipapi: query
storage.events -> apis.worker: pending uploads {
  style.stroke: "#e03131"
  style.stroke-dash: 5
}

# dashboard → clip-api
apis.dashboard -> apis.clipapi: REST

# upload VSTP (disabled)
apis.worker -> conveyor: VSTP pdevsample {
  style.stroke: "#e03131"
  style.stroke-dash: 5
}

# acesso remoto
tailscale -> apis.clipapi: :8080
tailscale -> apis.dashboard: :3000
tailscale -> jetson.preview: :8554 / :8889 { style.stroke-dash: 5; style.stroke: "#adb5bd" }
operator -> tailscale: VPN

# provisioning
operator -> registerapi: provision.sh
registerapi -> tailscale: auth_key + hostname
