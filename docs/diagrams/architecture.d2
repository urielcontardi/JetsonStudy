direction: right

# ─────────────────────────────────────────────────────────────────────
# Entrada
# ─────────────────────────────────────────────────────────────────────
cameras: "📷 Câmeras\nZED X One S × 2\nGMSL2 · kernel driver" {
  style.fill: "#f1f3f5"
  style.stroke: "#868e96"
}

operator: "👤 Operador" { shape: person }

# ─────────────────────────────────────────────────────────────────────
# Jetson Orin NX — tudo aqui roda na placa
# ─────────────────────────────────────────────────────────────────────
jetson: "Jetson Orin NX" {
  style.fill: "#f8f9fa"
  style.stroke: "#343a40"
  direction: right

  recorder: "🐳 recorder  [profile: jetson]\n\nCaptura câmeras via Argus/GStreamer.\nGrava DVR contínuo em fMP4.\nBuffer circular no tmpfs (60s).\nFlush periódico → events/ (independente do conveyor)\nAI ⚠ disabled" {
    style.fill: "#dbe4ff"
    style.stroke: "#4263eb"
  }

  storage: "💾 Storage  (host volumes)" {
    style.fill: "#f1f3f5"
    style.stroke: "#868e96"
    direction: down

    nvme: "NVMe — DVR segments (~20 dias)" { shape: cylinder; style.fill: "#ffffff" }
    tmpfs: "tmpfs — buffer circular 60s" { shape: cylinder; style.fill: "#fff9db"; style.stroke: "#f59f00" }
    sqlite: "SQLite — índice + eventos" { shape: cylinder; style.fill: "#ffffff" }
    events: "events/ — clips de IA\n⚠ só com ai.enabled: true" { shape: cylinder; style.fill: "#fff5f5"; style.stroke: "#e03131" }
  }

  clipapi: "🐳 clip-api  :8080\n\nGET /clips\nGET /events\nGET /events/{id}/clip" {
    style.fill: "#d3f9d8"
    style.stroke: "#2f9e44"
  }

  uploader: "🐳 uploader\n\nLê EventIndex (SQLite).\nEnvia via VSTP → Conveyor." {
    style.fill: "#d3f9d8"
    style.stroke: "#2f9e44"
  }

  dashboard: "🐳 dashboard  :8080 interno\n\nInterface web para\nclips e eventos" {
    style.fill: "#d3f9d8"
    style.stroke: "#2f9e44"
  }

  gateway: "🐳 gateway  :80 público\n\n/, /api" {
    style.fill: "#e7f5ff"
    style.stroke: "#1971c2"
  }

  preview: "🐳 preview  (MediaMTX)\n\nRecebe RTSP do recorder.\nReexpõe HLS/WebRTC.\n:8554 · :8888 · :8889" {
    style.fill: "#f8f9fa"
    style.stroke: "#adb5bd"
    style.stroke-dash: 5
  }
}

# ─────────────────────────────────────────────────────────────────────
# Saída / Infra
# ─────────────────────────────────────────────────────────────────────
tailscale: "🔒 Tailscale\nomnitrac-4cbb47c1331a" {
  shape: oval
  style.fill: "#e7f5ff"
  style.stroke: "#1971c2"
}

conveyor: "☁ Conveyor\nconveyor.tractian.com:8080\nVSTP → S3" {
  style.fill: "#e7f5ff"
  style.stroke: "#1971c2"
}

registerapi: "omni-ops\nregister-api" {
  style.fill: "#f3f0ff"
  style.stroke: "#7048e8"
}

# ─────────────────────────────────────────────────────────────────────
# Fluxo principal
# ─────────────────────────────────────────────────────────────────────
cameras -> jetson.recorder: "GMSL2 via Argus"
jetson.recorder -> jetson.storage: "grava fMP4\nindexas\nbuffer"
jetson.storage -> jetson.clipapi: "serve clips\nquery"
jetson.clipapi -> jetson.gateway: "/api"
jetson.dashboard -> jetson.gateway: "/"
jetson.gateway -> tailscale: :80
operator -> tailscale: "acesso remoto"

# preview: recorder pusha via RTSP; operador acessa direto na :8888 (WebRTC)
jetson.recorder -> jetson.preview: "RTSP push\n(via shm socket)" {
  style.stroke-dash: 5
  style.stroke: "#adb5bd"
}
jetson.preview -> tailscale: ":8888 WebRTC\n(direto, bypassa gateway)" {
  style.stroke-dash: 5
  style.stroke: "#adb5bd"
}

# ─────────────────────────────────────────────────────────────────────
# Fluxo desabilitado
# ─────────────────────────────────────────────────────────────────────
jetson.storage -> jetson.uploader: "lê events/\n+ EventIndex"
jetson.uploader -> conveyor: "VSTP"

# ─────────────────────────────────────────────────────────────────────
# Dev / Provisioning
# ─────────────────────────────────────────────────────────────────────
operator -> registerapi: "provision.sh" {
  style.stroke-dash: 5
  style.stroke: "#7048e8"
}
registerapi -> tailscale: "auth_key" {
  style.stroke-dash: 5
  style.stroke: "#7048e8"
}
