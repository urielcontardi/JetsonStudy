direction: right

cameras: "📷 ZED X One S × 2\nGMSL2 · kernel driver" {
  style.fill: "#f1f3f5"
  style.stroke: "#868e96"
}

operator: "👤 Operador" { shape: person }

jetson: "Jetson Orin NX" {
  style.fill: "#f8f9fa"
  style.stroke: "#343a40"
  direction: right

  recorder: "🐳 recorder" {
    style.fill: "#dbe4ff"
    style.stroke: "#4263eb"
    direction: down

    cam0: "cam0 — front\nArgus 0 · NVENC\nnvinfer cam0.engine\nbuffer 60s" {
      style.fill: "#edf2ff"
      style.stroke: "#4263eb"
    }
    cam1: "cam1 — rear\nArgus 1 · NVENC\nnvinfer cam1.engine\nbuffer 60s" {
      style.fill: "#edf2ff"
      style.stroke: "#4263eb"
    }
  }

  storage: "💾 Storage" {
    style.fill: "#f1f3f5"
    style.stroke: "#868e96"
    direction: down

    nvme:   "NVMe  DVR cam0+cam1" { shape: cylinder; style.fill: "#fff" }
    tmpfs:  "tmpfs  buffer cam0+cam1" { shape: cylinder; style.fill: "#fff9db"; style.stroke: "#f59f00" }
    sqlite: "SQLite  índice+eventos" { shape: cylinder; style.fill: "#fff" }
    events: "events/  clips" { shape: cylinder; style.fill: "#fff5f5"; style.stroke: "#e03131" }
  }

  models: "📦 models/ :ro\ncam0/detector.engine\ncam1/classifier.engine" {
    shape: cylinder
    style.fill: "#f3f0ff"
    style.stroke: "#7048e8"
  }

  uploader: "🐳 uploader\nEventIndex → VSTP" {
    style.fill: "#d3f9d8"
    style.stroke: "#2f9e44"
  }

  clipapi: "🐳 clip-api  :8080\n/clips · /events · /range" {
    style.fill: "#d3f9d8"
    style.stroke: "#2f9e44"
  }

  preview: "🐳 preview\nMediaMTX\n:8888 · :8554" {
    style.fill: "#f8f9fa"
    style.stroke: "#adb5bd"
    style.stroke-dash: 5
  }

  dashboard: "🐳 dashboard\nsplit view cam0|cam1" {
    style.fill: "#d3f9d8"
    style.stroke: "#2f9e44"
  }

  gateway: "🐳 gateway  :80\n/, /api" {
    style.fill: "#e7f5ff"
    style.stroke: "#1971c2"
  }
}

conveyor: "☁ Conveyor\nVSTP → S3" {
  style.fill: "#e7f5ff"
  style.stroke: "#1971c2"
}

tailscale: "🔒 Tailscale" {
  shape: oval
  style.fill: "#e7f5ff"
  style.stroke: "#1971c2"
}

cameras -> jetson.recorder: "GMSL2"
jetson.models -> jetson.recorder: "engines" { style.stroke: "#7048e8"; style.stroke-dash: 5 }
jetson.recorder -> jetson.storage: "DVR · buffer · flush"
jetson.recorder -> jetson.preview: "RTSP push" { style.stroke-dash: 5; style.stroke: "#adb5bd" }
jetson.storage -> jetson.uploader: "events/"
jetson.storage -> jetson.clipapi: "query"
jetson.uploader -> conveyor: "VSTP"
jetson.clipapi -> jetson.gateway: "/api"
jetson.dashboard -> jetson.gateway: "/"
jetson.gateway -> tailscale: ":80"
jetson.preview -> tailscale: ":8888" { style.stroke-dash: 5; style.stroke: "#adb5bd" }
operator -> tailscale: "acesso remoto"
