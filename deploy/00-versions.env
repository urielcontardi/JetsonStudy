# ==========================================================================
# 00-versions.env — Fonte única de verdade do provisionamento do host
# ==========================================================================
# Edite estes valores por device/lote. Os scripts de deploy sourceiam este
# arquivo. NÃO faça mudanças no host fora dos scripts — registre tudo aqui.
#
# Uso: copie para 00-versions.env (este arquivo já versionado é o template)
# e ajuste os valores específicos da sua placa.
# ==========================================================================

# --- Identidade do device ---------------------------------------------------
# Nome usado no Tailscale (MagicDNS) e na frota. Ex.: orwell-01
DEVICE_NAME="orwell-01"

# --- Armazenamento ----------------------------------------------------------
# Caminho onde ficam os segmentos de vídeo + índice. Como o Ubuntu roda do
# próprio NVMe, por padrão é um diretório no FS de boot (NÃO formatamos nada).
DATA_DIR="/var/lib/orwell/data"

# Modo de storage:
#   "dir"  = usa DATA_DIR no disco existente (PADRÃO, seguro)
#   "disk" = monta um NVMe DEDICADO e SEPARADO (DESTRUTIVO ao formatar!)
STORAGE_MODE="dir"
# Só usados se STORAGE_MODE="disk". Confirme MUITO bem o device antes!
DEDICATED_NVME_DEVICE=""        # ex.: /dev/nvme1n1  (NUNCA o disco de boot)
DEDICATED_NVME_FS="ext4"

# Limite de uso de disco para a rotação do buffer circular (%).
DISK_HIGH_WATERMARK="85"

# --- Driver GMSL da Stereolabs (ESPECÍFICO DA PLACA + VERSÃO L4T) -----------
# O .deb deve casar: placa (ZED Box / ZED Link Duo/Mono), deserializer e L4T.
# Descubra sua versão L4T com:  cat /etc/nv_tegra_release
# Baixe o .deb correto em: https://www.stereolabs.com/developers/drivers
# Coloque o arquivo em deploy/artifacts/ e aponte o nome abaixo,
# OU informe uma URL direta.
GMSL_DRIVER_DEB=""              # ex.: stereolabs-zedlink-duo_1.3.2-LI-MAX96712-all-L4T36.4.0_arm64.deb
GMSL_DRIVER_URL=""             # opcional: URL direta para baixar o .deb

# --- Docker / NVIDIA runtime ------------------------------------------------
# Tornar o runtime "nvidia" o default do Docker (recomendado p/ GPU/câmera).
DOCKER_DEFAULT_RUNTIME_NVIDIA="true"

# --- Tailscale --------------------------------------------------------------
# Auth key (tskey-...) para ingresso não-interativo. Deixe vazio p/ login
# interativo. NÃO comite a key real — exporte no ambiente ou use secret.
TS_AUTHKEY=""
TS_ENABLE_SSH="true"

# --- Tempo ------------------------------------------------------------------
TIMEZONE="UTC"
